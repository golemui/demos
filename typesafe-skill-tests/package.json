{
  "name": "golemui-typesafe-skill-tests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Unit tests for agent skills: does an LLM reading this section of SKILL.md reach the decision the skill intends? Graded by TypeSafe, no Claude API involved.",
  "scripts": {
    "test": "tsx src/cli.ts --skill ../../golemui/skills/golemui tests",
    "test:dry": "tsx src/cli.ts --skill ../../golemui/skills/golemui --dry-run tests",
    "test:ci": "tsx src/cli.ts --skill ../../golemui/skills/golemui --json tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3"
  }
}

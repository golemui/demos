# Copy to .env (this folder, or the repo root) — picked up by `npm run dev`.
# Real environment variables always take precedence over this file.
ANTHROPIC_API_KEY=sk-ant-...

# Only for keys NOT scoped to a workspace (the API then asks for one):
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional overrides:
# AGENT_MODEL=claude-sonnet-5-5
# SERVER_PORT=8000

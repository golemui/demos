#!/bin/sh
# Keep the generated copies of /shared (each demo's src/_shared/ and the hotel
# core in the hotel demos) in sync before every commit, so they land in the same
# commit as the source change (and the CI sync-check always passes). Wired via
# `git config core.hooksPath .githooks`, which the root `npm install` sets up
# through the package.json "prepare" script.
set -e

node scripts/sync-shared.mjs
node scripts/sync-shared.mjs --paths | xargs git add --

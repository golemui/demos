{
  "$schema": "https://golemui.com/schemas/form.schema.json",
  "form": [
    {
      "kind": "input",
      "type": "typewriter",
      "path": "read.chapter1",
      "props": {
        "title": "Capítulo 1",
        "text": "{{$meta.chapter1}}",
        "speed": 28
      }
    },
    {
      "kind": "input",
      "type": "list",
      "path": "q1",
      "label": "Does Lucas find food in the forest?",
      "props": {
        "items": [
          {
            "value": "yes",
            "label": "Sí"
          },
          {
            "value": "no",
            "label": "No"
          }
        ]
      },
      "include": {
        "when": "$form.read?.chapter1 === true"
      },
      "on": {
        "change": "checkAnswer"
      }
    },
    {
      "kind": "input",
      "type": "radiogroup",
      "path": "q2",
      "label": "Where does Lucas live?",
      "props": {
        "options": [
          {
            "value": "forest",
            "label": "En el bosque"
          },
          {
            "value": "river",
            "label": "En el río"
          },
          {
            "value": "city",
            "label": "En la ciudad"
          }
        ]
      },
      "include": {
        "when": "$form.q1 !== undefined"
      },
      "on": {
        "change": "checkAnswer"
      }
    },
    {
      "kind": "input",
      "type": "typewriter",
      "path": "read.chapter2",
      "props": {
        "title": "Capítulo 2",
        "text": "{{$meta.chapter2}}",
        "speed": 28
      },
      "include": {
        "when": "$form.q2 !== undefined"
      }
    },
    {
      "kind": "input",
      "type": "radiogroup",
      "path": "q3",
      "label": "Who does Lucas meet at the river?",
      "props": {
        "options": [
          {
            "value": "duck",
            "label": "Una pata"
          },
          {
            "value": "fish",
            "label": "Un pez"
          },
          {
            "value": "rabbit",
            "label": "Un conejo"
          }
        ]
      },
      "include": {
        "when": "$form.read?.chapter2 === true"
      },
      "on": {
        "change": "checkAnswer"
      }
    },
    {
      "kind": "input",
      "type": "multiList",
      "path": "q4",
      "label": "What happens at the river? Select everything that is true.",
      "props": {
        "items": [
          {
            "value": "caught_fish",
            "label": "Lucas pesca un pez"
          },
          {
            "value": "hat",
            "label": "El viento se lleva el sombrero de Marta"
          },
          {
            "value": "bread",
            "label": "Marta ofrece compartir su pan"
          },
          {
            "value": "swim",
            "label": "Lucas nada en el río"
          }
        ]
      },
      "include": {
        "when": "$form.q3 !== undefined"
      },
      "on": {
        "change": "checkAnswer"
      }
    },
    {
      "kind": "input",
      "type": "typewriter",
      "path": "read.chapter3",
      "props": {
        "title": "Capítulo 3",
        "text": "{{$meta.chapter3}}",
        "speed": 28
      },
      "include": {
        "when": "$form.q4 !== undefined"
      }
    },
    {
      "kind": "input",
      "type": "list",
      "path": "q5",
      "label": "Is Lucas still hungry at the end?",
      "props": {
        "items": [
          {
            "value": "yes",
            "label": "Sí"
          },
          {
            "value": "no",
            "label": "No"
          }
        ]
      },
      "include": {
        "when": "$form.read?.chapter3 === true"
      },
      "on": {
        "change": "checkAnswer"
      }
    },
    {
      "kind": "input",
      "type": "radiogroup",
      "path": "q6",
      "label": "Where was Marta's hat?",
      "props": {
        "options": [
          {
            "value": "tree",
            "label": "En un árbol"
          },
          {
            "value": "water",
            "label": "En el agua"
          },
          {
            "value": "rock",
            "label": "Debajo de una piedra"
          }
        ]
      },
      "include": {
        "when": "$form.q5 !== undefined"
      },
      "on": {
        "change": "checkAnswer"
      }
    },
    {
      "kind": "input",
      "type": "textarea",
      "path": "summary",
      "label": "Tu turno — tell the story in your own words, in Spanish",
      "props": {
        "placeholder": "Lucas es un zorro que…",
        "minimumHeight": 110,
        "autoGrow": true
      },
      "validator": {
        "type": "string",
        "required": true,
        "minLength": 20,
        "messages": {
          "invalid": "Write a short summary of the story",
          "required": "Write a short summary of the story",
          "minLength": "A little longer — tell us what happened"
        }
      },
      "include": {
        "when": "$form.q6 !== undefined"
      },
      "on": {
        "change": "checkSummary"
      }
    },
    {
      "kind": "display",
      "type": "rubric",
      "props": {
        "hungry": "{{$meta.rubric?.hungry ?? ''}}",
        "no_fish": "{{$meta.rubric?.no_fish ?? ''}}",
        "duck": "{{$meta.rubric?.duck ?? ''}}",
        "hat_lost": "{{$meta.rubric?.hat_lost ?? ''}}",
        "hat_tree": "{{$meta.rubric?.hat_tree ?? ''}}",
        "bread": "{{$meta.rubric?.bread ?? ''}}",
        "completeness": "{{$meta.rubric?.completeness ?? ''}}"
      },
      "include": {
        "when": "$form.q6 !== undefined"
      }
    },
    {
      "kind": "action",
      "type": "button",
      "label": "Finish lesson",
      "actionType": "submit",
      "include": {
        "when": "$form.q6 !== undefined"
      }
    }
  ]
}

{
  "$schema": "https://golemui.com/schemas/form.schema.json",
  "form": [
    {
      "kind": "input",
      "type": "textinput",
      "path": "nombreCompleto",
      "label": "Nombre completo",
      "validator": {
        "type": "string",
        "required": true,
        "minLength": 3
      }
    },
    {
      "kind": "input",
      "type": "datePicker",
      "path": "fechaDeNacimiento",
      "label": "Fecha de nacimiento"
    },
    {
      "kind": "input",
      "type": "radiogroup",
      "path": "nivelDeExperiencia",
      "label": "Nivel de experiencia"
    },
    {
      "kind": "input",
      "type": "multiList",
      "path": "queFrameworksUsasPuedeMarcarVarios",
      "label": "¿Qué frameworks usas? puede marcar varios"
    },
    {
      "kind": "input",
      "type": "number",
      "path": "nuMeroDeAsistentes",
      "label": "Número de asistentes"
    },
    {
      "kind": "input",
      "type": "checkbox",
      "path": "aceptoLaPoliTicaDePrivacidad",
      "label": "Acepto la política de privacidad",
      "validator": {
        "type": "boolean",
        "required": true,
        "const": true
      }
    },
    {
      "kind": "input",
      "type": "textarea",
      "path": "comentarios",
      "label": "Comentarios",
      "validator": {
        "type": "string",
        "maxLength": 500
      }
    },
    {
      "kind": "action",
      "type": "button",
      "label": "Submit",
      "actionType": "submit"
    }
  ]
}
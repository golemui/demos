{
  "$schema": "https://golemui.com/schemas/form.schema.json",
  "form": [
    {
      "kind": "input",
      "type": "textinput",
      "path": "name",
      "label": "name",
      "validator": {
        "type": "string"
      }
    },
    {
      "kind": "input",
      "type": "textinput",
      "path": "surname",
      "label": "surname",
      "validator": {
        "type": "string"
      }
    },
    {
      "kind": "input",
      "type": "number",
      "path": "age",
      "label": "age",
      "validator": {
        "type": "number"
      }
    },
    {
      "kind": "action",
      "type": "button",
      "label": "Submit",
      "actionType": "submit"
    }
  ]
}